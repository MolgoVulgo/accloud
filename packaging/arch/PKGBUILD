pkgname=anycubic-cloud-manager-v3
pkgver=1.0.0rc2
pkgrel=1
_tag="1.0.0-RC.2"
pkgdesc="accloud — independent resin-cloud manager (Qt6/QML)"
arch=('x86_64')
url="https://github.com/MolgoVulgo/accloud"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-mqtt' 'openssl' 'zlib' 'libxcrypt')
makedepends=('cmake' 'ninja' 'pkgconf' 'gcc' 'nlohmann-json' 'qt6-tools')
source=(
  "accloud-${_tag}.tar.gz::${url}/archive/refs/tags/${_tag}.tar.gz"
  'acm.png'
)
sha256sums=(
  '459876d5c1b5f44106ab5df0ae4b1a4500e6ce87b2c573c08f1472157204c04c'
  'ce5e113f3fa599dc335c5c8d8c4c8cc4b8f64f8887a2a0aba9a40da17c03e622'
)

build() {
  cmake -S "${srcdir}/accloud-${_tag}/accloud" -B "${srcdir}/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DACCLOUD_ENABLE_QT=ON -DACCLOUD_REQUIRE_QT=ON \
    -DACCLOUD_DEBUG=OFF -DACCLOUD_ENABLE_EXPERIMENTAL_VIEWER=ON \
    -DACCLOUD_ENABLE_QML_TESTS=OFF -DACCLOUD_ENABLE_LIVE_TESTS=OFF \
    -DACCLOUD_VERSION_PRERELEASE=RC.2
  cmake --build "${srcdir}/build" --target accloud_cli
}

package() {
  local _repo_dir="${srcdir}/accloud-${_tag}"
  install -Dm755 "${srcdir}/build/accloud_cli" "${pkgdir}/opt/accloud/accloud_cli"
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/accloud/accloud_cli "${pkgdir}/usr/bin/accloud_cli"
  install -Dm644 "${_repo_dir}/packaging/arch/accloud.desktop" \
    "${pkgdir}/usr/share/applications/accloud.desktop"
  install -Dm644 "${_repo_dir}/packaging/org.accloud.App.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/org.accloud.App.metainfo.xml"
  install -Dm644 "${srcdir}/acm.png" \
    "${pkgdir}/usr/share/pixmaps/org.accloud.App.png"
  install -Dm644 "${_repo_dir}/accloud/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  # MQTT TLS credentials are supplied externally; never package private keys.
}
